# Telegram MTProto (Userbot) - get from https://my.telegram.org
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
USERBOT_SESSION_NAME=userbot_session

# Telegram Bot API (Control Bot) - get from @BotFather
CONTROL_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
ADMIN_TELEGRAM_ID=987654321

# Google Gemini API - get from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-flash-lite-latest

# Database & Cache (Docker Compose service names)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/messenger_ai
REDIS_URL=redis://redis:6379/0

# Human Simulation Settings
DEFAULT_HUMAN_DELAY_MIN=2.0
DEFAULT_HUMAN_DELAY_MAX=6.0
DEFAULT_CONTEXT_WINDOW_LIMIT=15

# App Settings
LOG_LEVEL=INFO
